POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fanfic:fanfic@postgres:5432/fanfic_rag
LOCAL_DATABASE_URL=postgresql+psycopg://fanfic:fanfic@localhost:5432/fanfic_rag

