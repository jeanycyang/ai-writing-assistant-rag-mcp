POSTGRES_DB=ai_writing_assistance
POSTGRES_USER=ai_writer
POSTGRES_PASSWORD=ai_writer
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ai_writer:ai_writer@postgres:5432/ai_writing_assistance
LOCAL_DATABASE_URL=postgresql+psycopg://ai_writer:ai_writer@localhost:5432/ai_writing_assistance
# Optional: bind the local STDIO MCP server to a named work database.
# Example: `AI_WRITING_WORK=work_id_1` makes the server use database `work_id_1`.
AI_WRITING_WORK=

RAG_API_HOST=0.0.0.0
RAG_API_PORT=8001
RAG_API_URL=http://rag-api:8001

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8

RAW_CHUNK_SIZE=650
RAW_CHUNK_OVERLAP=120

SUMMARY_DATA_DIR=data/sample/summaries
RAW_DATA_DIR=data/sample/raw

# Optional defaults for scripts/tailscale_funnel.sh
TAILSCALE_FUNNEL_TARGET_HOST=127.0.0.1
TAILSCALE_FUNNEL_TARGET_PORT=8001
TAILSCALE_FUNNEL_HTTPS_PORT=443
TAILSCALE_MCP_PATH=/mcp
